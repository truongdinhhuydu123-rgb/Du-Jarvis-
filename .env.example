# Chép file này thành ".env" (cùng thư mục) rồi dán key vào sau dấu =.
# File .env chứa key riêng: đừng gửi cho ai, đừng đưa lên GitHub.

# AI trả lời (miễn phí): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Nghe kỹ câu lệnh bằng Whisper của Groq (miễn phí): https://console.groq.com/keys
GROQ_API_KEY=

# Bot Telegram: tạo bot với @BotFather, dán token. Chat ID: nhắn /start cho bot, bot báo số.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Calendar tự động: URL ứng dụng web Apps Script + mật khẩu (giống MAT_KHAU trong
# google-calendar/lich.gs). Bỏ trống thì trợ lý gửi link điền sẵn để bấm Lưu.
GCAL_WEBHOOK_URL=
GCAL_SECRET=

# (Không bắt buộc) AI Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=

# (Không bắt buộc, cần gói trả phí) giọng ElevenLabs: https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
